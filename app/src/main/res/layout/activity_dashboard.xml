<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================================================= -->
        <!-- KEPALA HALAMAN / PROFIL -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#16213E"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@string/desc_avatar"
                android:src="@drawable/ic_profil" />

            <TextView
                android:id="@+id/tvNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nama"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="email@example.com"
                android:textColor="#C7D2DC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBadgeSesi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#1F3B2E"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/badge_sesi_aktif"
                android:textColor="#9BE8BF"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- KARTU WAKTU LOGIN -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_terakhir_masuk"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvWaktu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="06 Okt 2026, 19:59"
                android:textColor="#16213E"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MENU EDIT PROFIL -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="18dp"
            android:text="👤  Edit Profil                         ›"
            android:textColor="#334155"
            android:textSize="17sp" />


        <!-- ================================================= -->
        <!-- MENU NOTIFIKASI -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="18dp"
            android:text="🔔  Notifikasi                         ›"
            android:textColor="#334155"
            android:textSize="17sp" />


        <!-- ================================================= -->
        <!-- MENU PENGATURAN -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="18dp"
            android:text="⚙️  Pengaturan                       ›"
            android:textColor="#334155"
            android:textSize="17sp" />


        <!-- ================================================= -->
        <!-- TOMBOL KELUAR -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="30dp"
            android:text="@string/btn_keluar"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>